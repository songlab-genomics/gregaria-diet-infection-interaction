### =================================================================
### RNA-SEQ VARIANT CALLING ONLY
### =================================================================
###
### Use this Snakefile when you want SNPs from completed STAR BAM files.
### It deliberately does not include fastp, STAR, Salmon, or featureCounts,
### so existing files in /data/songlab/maeva/*-timecourse/data are read as
### fixed inputs rather than regenerated by Snakemake.

include: "config.smk"

# Variant calling should discover samples from existing STAR BAMs only.
SAMPLE_DISCOVERY = "star_bam"

include: "rules/00_samples.smk"
include: "rules/04_variant_calling_rnaseq.smk"

rule all:
    input:
        rnaseq_variant_tissue_outputs()
